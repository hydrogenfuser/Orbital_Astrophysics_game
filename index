<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Osiris OS</title><link rel="stylesheet" href="style.css"></head><body><div class="terminal-screen"><div id="output-log">OSIRIS KERNEL BOOT... OK.</div><div class="input-line"><span class="prompt">></span><input type="text" id="terminal-input" autofocus autocomplete="off"></div></div><script src="auth.js"></script><script src="terminal.js"></script></body></html>

/* SEGMENT 1.1: style.css */
:root{--t:#33ff00;--b:#050a02;--f:'Courier New',Courier,monospace}body{background:var(--b);color:var(--t);font-family:var(--f);margin:0;padding:20px;overflow:hidden;text-shadow:0 0 5px var(--t)}.terminal-screen{display:flex;flex-direction:column;height:95vh;justify-content:flex-end}#output-log{white-space:pre-wrap;overflow-y:auto;margin-bottom:10px;padding-right:10px}.input-line{display:flex;align-items:center}.prompt{margin-right:10px;font-weight:bold}#terminal-input{background:transparent;border:none;color:var(--t);font-family:var(--f);font-size:16px;flex-grow:1;outline:none;text-shadow:0 0 5px var(--t)}

// SEGMENT 1.2: auth.js
const AuthSystem={isAuthenticated:!1,authState:0,validUser:"DIRECTOR",validPass:"TIER0",beginLogin:function(){this.isAuthenticated=!1,this.authState=0,Terminal.log("\nAGENCY CREDENTIALS REQUIRED.\nLOGIN:")},isAwaitingPassword:function(){return 1===this.authState},handleAuth:function(e){e=e.toUpperCase().trim(),0===this.authState?e===this.validUser?(this.authState=1,Terminal.log("PASSWORD:"),document.getElementById("terminal-input").type="password"):Terminal.log("ERR: UNKNOWN IDENTITY.\nLOGIN:"):1===this.authState&&(e===this.validPass?(this.isAuthenticated=!0,document.getElementById("terminal-input").type="text",Terminal.log("\n[AUTH SUCCESS] WELCOME TO OSIRIS.")):(this.authState=0,document.getElementById("terminal-input").type="text",Terminal.log("ERR: INCORRECT PASSWORD.\nLOGIN:")))}};

// SEGMENT 1.3: terminal.js
const Terminal={outputLog:document.getElementById("output-log"),inputField:document.getElementById("terminal-input"),init:function(){document.addEventListener("click",()=>this.inputField.focus()),this.inputField.addEventListener("keydown",e=>{"Enter"===e.key&&(e=this.inputField.value,""!==e.trim()&&this.processInput(e),this.inputField.value="")}),AuthSystem.beginLogin()},processInput:function(e){AuthSystem.isAwaitingPassword()?this.log("> ********"):this.log("> "+e),AuthSystem.isAuthenticated?this.log("ERR: MAIN PARSER OFFLINE."):AuthSystem.handleAuth(e)},log:function(e){this.outputLog.innerText+="\n"+e,window.scrollTo(0,document.body.scrollHeight)}};window.onload=()=>Terminal.init();
